# Local development defaults. Copy to .env for `npm run dev`.
# In Docker Compose these values are set in compose.yaml and the database is
# reachable at host `db`, port 5432.
DATABASE_URL=postgres://ticket:ticket_dev_password@localhost:5433/ticket_queue
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Seed four demo accounts and a populated queue on first boot.
# Never enable this against a production database.
SEED_DEMO=true
DEMO_PASSWORD=demo-pass-123

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
